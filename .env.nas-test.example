# Stage 6C NAS isolation only. Never point this file at production data.
# Use the immutable candidate tag selected for the current acceptance run.
IMAGE_TAG=baseline-stage6c-qdrant-health-20260826-01

# New empty NAS-local POSIX directories. Do not use SMB/NFS mounts.
DATA_ROOT=/path/to/pr-test/PersonalResourceManager-stage6c-test
SCAN_ROOT=/path/to/pr-test/scan-files
RAG_VECTOR_DATA_ROOT=/path/to/pr-test/PersonalResourceManager-stage6c-qdrant

# Keep these ports separate from production and other test stacks.
FRONTEND_PORT=15375
BACKEND_PORT=13035
QDRANT_PORT=16333

# Existing external network used by Clash and the HTTPS tunnel/reverse proxy.
PROXY_NETWORK_NAME=pr-network

# Exact browser origins, comma-separated. Never use a wildcard or add paths.
CORS_ORIGIN=http://nas-lan-address:15375,https://stage6c.example.test

# Test-only Owner bootstrap values. Generate a unique password of 12+ chars.
DEFAULT_USERNAME=stage6c_admin
DEFAULT_PASSWORD=

# Optional integrations. Leave credentials empty unless this test needs them.
BANGUMI_ACCESS_TOKEN=
HTTP_PROXY=http://clash:7890
HTTPS_PROXY=http://clash:7890
ALL_PROXY=socks5://clash:7891
NO_PROXY=localhost,127.0.0.1,stage6-backend,stage6-redis,stage6-qdrant,backend,qdrant

# Isolated Qdrant derived index. The NAS test Compose starts it by default
# because the NAS GUI does not reliably expose Compose profiles.
RAG_VECTOR_ENABLED=true
RAG_VECTOR_BASE_URL=http://stage6-qdrant:6333
RAG_VECTOR_COLLECTION=rag_vectors_stage6c
RAG_VECTOR_TIMEOUT_MS=5000
RAG_VECTOR_EMBEDDING_PROVIDER=lm-studio
RAG_VECTOR_EMBEDDING_MODEL_ID=text-embedding-nomic-embed-text-v1.5
RAG_VECTOR_EMBEDDING_MODEL_REVISION=gguf-sha256-d4e388894e09cf3816e8b0896d81d265b55e7a9fff9ab03fe8bf4ef5e11295ac
RAG_VECTOR_EMBEDDING_DIMENSIONS=768
RAG_VECTOR_EMBEDDING_INPUT_LIMIT=2048
RAG_VECTOR_EMBEDDING_DISTANCE=cosine
RAG_VECTOR_EMBEDDING_NORMALIZATION=l2
RAG_VECTOR_EMBEDDING_CONFIG_HASH=7d93077b98e4a05746f0de951f9156d9671de74a446a4312b2baaa092eabbdad

# Qwen answer model advertised by the isolated PC Worker. The backend stores
# only this fixed identity; LM Studio remains loopback-only on the PC.
RAG_ANSWER_PROVIDER=lm-studio
RAG_ANSWER_MODEL_ID=qwen3.5-9b-uncensored-hauhaucs-aggressive@q6_k
RAG_ANSWER_MODEL_REVISION=Q6_K
RAG_ANSWER_CONTEXT_LIMIT=32768
RAG_ANSWER_MAX_OUTPUT_BYTES=16384
RAG_ANSWER_MAX_EVIDENCE=64
RAG_ANSWER_DIMENSIONS=1
RAG_ANSWER_INPUT_LIMIT=32768
RAG_ANSWER_CONFIG_HASH=b1d5516cbd27c01653d2193781d88ed2bb20f278cf4d59ad0d957bd01ca5547a

# Optional PC Reranker identity. The actual TEI service remains on the PC.
RAG_RERANKER_ENABLED=true
RAG_RERANKER_PROVIDER=hugging-face-tei
RAG_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RAG_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_RERANKER_DIMENSIONS=1
RAG_RERANKER_INPUT_LIMIT=512
RAG_RERANKER_CONFIG_HASH=5d456e4278f50b53df3cd788abcda2fccb91c65104b1f5063fd12eb741b2440a
