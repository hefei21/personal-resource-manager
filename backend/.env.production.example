# ==================== 生产环境配置 ====================
# 请复制此文件为 .env.production 并修改配置

# 运行环境
NODE_ENV=production

# 服务端口
PORT=3000

# 首次初始化凭据（密码至少 12 位且不得使用公开示例值）
# node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=

# 数据路径
DATA_PATH=/app/data
DB_PATH=/app/data/database/app.db
DATABASE_BACKUP_PATH=/app/data/database/backups
UPLOADS_PATH=/app/data

# CORS 允许的来源（多个用逗号分隔）
# 示例：CORS_ORIGIN=https://your-domain.com,https://another-domain.com
CORS_ORIGIN=https://your-domain.com

# 公共演示默认在 production 关闭。只有专用 demo-only 运行面完成网络、资源和限流验收后才显式开启。
DEMO_ENABLED=false
# 只有反向代理地址已被运行环境严格限定时才信任其客户端 IP；Owner 主后端保持 false。
DEMO_TRUST_PROXY_IP=false
# demo-only 运行面同时处理的请求上限；有效范围 1–128。
DEMO_MAX_INFLIGHT=32

# 允许盗链检查的来源（多个用逗号分隔）
# 留空则不检查 Referer
ALLOWED_ORIGINS=https://your-domain.com

# Redis 配置（可选）
REDIS_HOST=redis
REDIS_PORT=6379

# 代理配置（可选）
# HTTP_PROXY=http://clash:7890
