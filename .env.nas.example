# Immutable GHCR tag produced by the baseline image workflow.
IMAGE_TAG=baseline-20260729

# Existing NAS production root. Do not append quotes.
DATA_ROOT=/path/to/PersonalResourceManager

# Cross-origin frontend allowed to call the backend. Same-origin deployments
# can leave this empty. Use exact URL origins only; wildcard is not supported.
CORS_ORIGIN=http://nas-lan-address:5173

DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=

# Optional integrations.
BANGUMI_ACCESS_TOKEN=
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,redis,backend

# Optional Qdrant vector index. Keep disabled unless the local POSIX path and
# the complete, hash-bound embedding identity have been explicitly verified.
RAG_VECTOR_ENABLED=false
RAG_VECTOR_DATA_ROOT=/path/to/PersonalResourceManager/qdrant
RAG_VECTOR_BASE_URL=http://qdrant:6333
RAG_VECTOR_COLLECTION=rag_vectors
RAG_VECTOR_TIMEOUT_MS=5000
RAG_VECTOR_EMBEDDING_PROVIDER=lm-studio
RAG_VECTOR_EMBEDDING_MODEL_ID=text-embedding-nomic-embed-text-v1.5
RAG_VECTOR_EMBEDDING_MODEL_REVISION=gguf-sha256-d4e388894e09cf3816e8b0896d81d265b55e7a9fff9ab03fe8bf4ef5e11295ac
RAG_VECTOR_EMBEDDING_DIMENSIONS=768
RAG_VECTOR_EMBEDDING_INPUT_LIMIT=2048
RAG_VECTOR_EMBEDDING_DISTANCE=cosine
RAG_VECTOR_EMBEDDING_NORMALIZATION=l2
RAG_VECTOR_EMBEDDING_CONFIG_HASH=7d93077b98e4a05746f0de951f9156d9671de74a446a4312b2baaa092eabbdad

# Optional PC answer model. It is never a NAS/FTS hard dependency.
RAG_ANSWER_PROVIDER=lm-studio
RAG_ANSWER_MODEL_ID=qwen3.5-9b-uncensored-hauhaucs-aggressive@q6_k
RAG_ANSWER_MODEL_REVISION=Q6_K
RAG_ANSWER_CONTEXT_LIMIT=32768
RAG_ANSWER_MAX_OUTPUT_BYTES=16384
RAG_ANSWER_MAX_EVIDENCE=64
RAG_ANSWER_DIMENSIONS=1
RAG_ANSWER_INPUT_LIMIT=32768
RAG_ANSWER_CONFIG_HASH=b1d5516cbd27c01653d2193781d88ed2bb20f278cf4d59ad0d957bd01ca5547a

# Optional PC Reranker. It is never a NAS/FTS/Hybrid hard dependency.
RAG_RERANKER_ENABLED=false
RAG_RERANKER_PROVIDER=hugging-face-tei
RAG_RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RAG_RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_RERANKER_DIMENSIONS=1
RAG_RERANKER_INPUT_LIMIT=512
RAG_RERANKER_CONFIG_HASH=5d456e4278f50b53df3cd788abcda2fccb91c65104b1f5063fd12eb741b2440a
