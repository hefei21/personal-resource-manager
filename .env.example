# ==========================================
# 个人资源管理系统 - 环境变量配置示例
# ==========================================
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 修改下面的配置
# 3. 运行：docker-compose up -d
# ==========================================

# ==================== 安全配置 ====================
# 首次安装凭据。密码必须至少 12 位且不能使用示例弱密码。
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=

# 同源部署可留空；仅跨域前端需要填写完整 Origin，多个值用逗号分隔。
# 禁止使用 *，例如：https://app.example.com
CORS_ORIGIN=

# ==================== Bangumi API 配置 ====================
# 【可选】Bangumi Access Token
# 获取方式：https://next.bgm.tv/demo/access-token
# 配置后可获取更多搜索结果（最多50条）
BANGUMI_ACCESS_TOKEN=

# ==================== 其他配置 ====================
# 如需修改其他配置，请直接编辑 docker-compose.yml
