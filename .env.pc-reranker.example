# Copy this file to D:\PRManagerAI\config\reranker\.env.
# The start/stop scripts never create or modify an env file in the repository.

RERANKER_CONTAINER_NAME=pr-manager-reranker
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANKER_MODEL_DIR=D:/PRManagerAI/models/bge-reranker-v2-m3
RERANKER_CACHE_DIR=D:/PRManagerAI/cache/huggingface
RERANKER_RUNTIME_DIR=D:/PRManagerAI/runtime/tei
RERANKER_LOG_DIR=D:/PRManagerAI/logs/bge-reranker
RERANKER_RUST_LOG=info
