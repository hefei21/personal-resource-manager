# Immutable backend image tag built from the stage-2 branch.
IMAGE_TAG=baseline-stage2-lock-probe-20260812-01

# Docker-visible absolute path of a new, empty NAS test directory.
# Never point this at the production database or production data root.
LOCK_TEST_ROOT=/path/to/isolated/pr-manager-lock-test

# Use a new safe token for every run so stale marker files cannot be reused.
LOCK_PROBE_RUN_ID=lock-probe-20260812-01
